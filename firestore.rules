rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'kalam172010@gmail.com' ||
        request.auth.token.email == 'kalam2000abc@gmail.com' ||
        request.auth.uid == 'res-1'
      );
    }

    // Users Collection (Profile, wallet balance, reseller stats)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Store Settings, API Configs, Payment Configs
    match /settings/{docId} {
      allow read, write: if true;
    }

    // Products catalog
    match /products/{productId} {
      allow read, write: if true;
    }

    // User Transactions
    match /transactions/{userId} {
      allow read, write: if true;
    }

    // User Purchased Keys
    match /purchased_keys/{userId} {
      allow read, write: if true;
    }

    // Real-Time Store Activities & Notifications (Deposits, Purchases)
    match /activities/{activityId} {
      allow read, write: if true;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

